# Vorlage für .env.local – echte Werte NICHT committen.
# Kopieren: cp .env.example .env.local
# Validierung: src/lib/env.ts (Zod). Für Build ohne Secrets: SKIP_ENV_VALIDATION=1

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Database → Connection string (URI, Transaction Mode für Serverless)
DATABASE_URL=postgresql://postgres:PASSWORT@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Supabase → Project Settings → API → service_role (nur serverseitig, niemals im Client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=

# Signatur für Kind-Einladungslinks. Erzeugen: openssl rand -base64 32
INVITE_TOKEN_SECRET=

# --- Optional: E-Mail-Versand (Magic Link etc.), sonst leer lassen ---
RESEND_API_KEY=
