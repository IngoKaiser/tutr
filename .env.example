# Vorlage für .env.local – echte Werte NICHT committen.
# Kopieren: cp .env.example .env.local
# Validierung: src/lib/env.ts (Zod). Für Build ohne Secrets: SKIP_ENV_VALIDATION=1
#
# Supabase nutzt das neue API-Key-System (Project Settings → API Keys):
#   Publishable key  sb_publishable_...  → öffentlich, darf in den Client, RLS greift
#   Secret key       sb_secret_...       → geheim, nur serverseitig, umgeht RLS

# --- Supabase (Project Settings → API) ---
# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project Settings → API Keys → "Publishable key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Laufzeit-Verbindung. Supabase → Connect → "Transaction pooler" (Port 6543).
# WICHTIG (ADR 0004 D1): Rolle `tutr_app`, nicht `postgres` – nur so greift RLS.
#
# Das Passwort hier ist NICHT das Supabase-Projektpasswort (das steht in
# MIGRATION_DATABASE_URL), sondern der Wert von TUTR_APP_DB_PASSWORD weiter unten.
# Reihenfolge: TUTR_APP_DB_PASSWORD setzen → `npm run db:policies` → diese Zeile füllen.
# ?sslmode=require ist Pflicht, sonst verbindet postgres.js im Klartext.
DATABASE_URL=postgresql://tutr_app.<project-ref>:<wert-von-TUTR_APP_DB_PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Migrationen, Policy-Runner und Seed laufen als Rolle `postgres` (umgeht RLS).
# Supabase → Connect → "Session pooler" (Port 5432). Ab F-04a erforderlich.
MIGRATION_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Passwort der Laufzeit-Rolle `tutr_app` (ADR 0004 D1). Erzeugen: openssl rand -base64 24
# Wird in F-04a angelegt; danach nutzt DATABASE_URL diese Rolle statt `postgres`.
TUTR_APP_DB_PASSWORD=

# Project Settings → API Keys → "Secret key" (nur serverseitig, niemals im Client)
SUPABASE_SECRET_KEY=

# --- Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=

# Signatur für Kind-Einladungslinks. Erzeugen: openssl rand -base64 32
INVITE_TOKEN_SECRET=

# --- Optional: E-Mail-Versand (Magic Link etc.), sonst leer lassen ---
RESEND_API_KEY=

# --- Nur in .env.test.local (zweites, leeres Supabase-Projekt für Policy-Tests) ---
# Policy-Tests sind destruktiv und dürfen nie gegen das echte Projekt laufen.
# TEST_DATABASE_URL=            # Transaction pooler (6543), Rolle tutr_app, mit ?sslmode=require
# TEST_MIGRATION_DATABASE_URL=  # Session pooler (5432), Rolle postgres
