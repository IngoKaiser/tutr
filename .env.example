# Vorlage für .env.local – echte Werte NICHT committen.
# Kopieren: cp .env.example .env.local
# Validierung: src/lib/env.ts (Zod). Für Build ohne Secrets: SKIP_ENV_VALIDATION=1
#
# Supabase nutzt das neue API-Key-System (Project Settings → API Keys):
#   Publishable key  sb_publishable_...  → öffentlich, darf in den Client, RLS greift
#   Secret key       sb_secret_...       → geheim, nur serverseitig, umgeht RLS

# --- Supabase (Project Settings → API) ---
# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project Settings → API Keys → "Publishable key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Connect → "Transaction pooler" (Port 6543, für Serverless).
# ?sslmode=require anhängen. PASSWORT = DB-Passwort (Project Settings → Database).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Project Settings → API Keys → "Secret key" (nur serverseitig, niemals im Client)
SUPABASE_SECRET_KEY=

# --- Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=

# Signatur für Kind-Einladungslinks. Erzeugen: openssl rand -base64 32
INVITE_TOKEN_SECRET=

# --- Optional: E-Mail-Versand (Magic Link etc.), sonst leer lassen ---
RESEND_API_KEY=
